{
  "info": {
    "_postman_id": "56dcbe8b-90cd-4aeb-8bf5-19ee0b6d665c",
    "name": "Healthcare Backend API",
    "description": "Examples and smoke tests for all registered API routes. Fast flow: set the patientEmail/password, doctorEmail/password, and adminEmail/password variables to valid local test accounts, then send the three Login requests to save tokens. Use an approved doctor to create and publish a schedule; its ID is captured automatically. Book as the patient, then run Get my appointments to capture appointmentId. The bKash payment/callback, email OTP, Google, and doctor-application/file-upload examples require their real integrations. Set IDs manually for lookup examples when not captured. Delete schedule is in the optional Cleanup folder. Prescription has no registered routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "patientEmail", "value": "", "type": "string" },
    { "key": "patientPassword", "value": "", "type": "string" },
    { "key": "doctorEmail", "value": "", "type": "string" },
    { "key": "doctorPassword", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "", "type": "string" },
    { "key": "adminPassword", "value": "", "type": "string" },
    { "key": "patientToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "registrationEmail", "value": "", "type": "string" },
    { "key": "registrationPassword", "value": "", "type": "string" },
    { "key": "emailOtp", "value": "", "type": "string" },
    { "key": "resetOtp", "value": "", "type": "string" },
    { "key": "newPassword", "value": "", "type": "string" },
    { "key": "googleIdToken", "value": "", "type": "string" },
    { "key": "doctorApplicationEmail", "value": "", "type": "string" },
    { "key": "doctorId", "value": "REPLACE_WITH_DOCTOR_ID", "type": "string" },
    { "key": "scheduleId", "value": "REPLACE_WITH_SCHEDULE_ID", "type": "string" },
    { "key": "appointmentId", "value": "REPLACE_WITH_APPOINTMENT_ID", "type": "string" },
    { "key": "paymentId", "value": "REPLACE_WITH_PAYMENT_ID", "type": "string" },
    { "key": "callbackPaymentId", "value": "", "type": "string" },
    { "key": "callbackStatus", "value": "success", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is successful or redirect', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 399);",
          "});",
          "pm.test('Response time is below 30 seconds', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(30000);",
          "});",
          "if (pm.response.code < 300 && (pm.response.headers.get('Content-Type') || '').includes('application/json')) {",
          "  pm.test('JSON response is valid and reports success', function () {",
          "    const body = pm.response.json();",
          "    if (body && Object.prototype.hasOwnProperty.call(body, 'success')) {",
          "      pm.expect(body.success).to.eql(true);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Server",
      "item": [
        { "name": "Root", "request": { "method": "GET", "url": "{{baseUrl}}/" } },
        { "name": "Test (checks bKash connectivity)", "request": { "method": "GET", "url": "{{baseUrl}}/test" } }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login patient (saves patientToken and refreshToken)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('Login returns an access token', function () { pm.expect(body.data.accessToken).to.be.a('string').and.not.empty; });",
            "pm.collectionVariables.set('patientToken', body.data.accessToken);",
            "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Login doctor (saves doctorToken)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('Login returns an access token', function () { pm.expect(body.data.accessToken).to.be.a('string').and.not.empty; });",
            "pm.collectionVariables.set('doctorToken', body.data.accessToken);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Login admin (saves adminToken)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('Login returns an access token', function () { pm.expect(body.data.accessToken).to.be.a('string').and.not.empty; });",
            "pm.collectionVariables.set('adminToken', body.data.accessToken);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Get current user",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/auth/me" }
        },
        {
          "name": "Refresh token (refreshToken cookie)",
          "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "refreshToken={{refreshToken}}" }], "url": "{{baseUrl}}/api/v1/auth/refresh-token" }
        },
        {
          "name": "Register patient",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Patient\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\",\n  \"patient\": { \"contactNumber\": \"01000000000\" }\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/register" }
        },
        {
          "name": "Verify patient email",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"otp\": \"{{emailOtp}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/verify-email" }
        },
        {
          "name": "Google login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/google" }
        },
        {
          "name": "Forgot password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{registrationEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/forgot-password" }
        },
        {
          "name": "Reset password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"otp\": \"{{resetOtp}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/auth/reset-password" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Update profile image (select a local file)",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "body": { "mode": "formdata", "formdata": [{ "key": "profileImage", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/v1/user/profile-image" }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Apply as doctor (select a resume file)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "if (body.data && body.data.doctor && body.data.doctor.id) pm.collectionVariables.set('doctorId', body.data.doctor.id);"
          ] } }],
          "request": {
            "method": "POST",
            "description": "The data form field is the JSON application example. Select a resume file; this route also depends on Cloudinary, SMTP, and Redis.",
            "body": { "mode": "formdata", "formdata": [
              { "key": "data", "value": "{\n  \"user\": { \"name\": \"Test Doctor\", \"email\": \"{{doctorApplicationEmail}}\" },\n  \"doctor\": {\n    \"address\": \"123 Test Street\",\n    \"specialization\": \"General Practice\",\n    \"licenseNumber\": \"TEST-LICENSE-001\",\n    \"qualifications\": \"MBBS\",\n    \"experienceYears\": 5,\n    \"bio\": \"Postman test doctor\",\n    \"consultationFee\": 500,\n    \"contactNumber\": \"01000000000\"\n  }\n}", "type": "text" },
              { "key": "resume", "type": "file", "src": "" },
              { "key": "additionalFiles", "type": "file", "src": "" }
            ] },
            "url": "{{baseUrl}}/api/v1/doctor/apply-as-doctor"
          }
        },
        {
          "name": "Verify doctor email",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{doctorApplicationEmail}}\",\n  \"otp\": \"{{emailOtp}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/doctor/apply-as-doctor/verify-email" }
        },
        {
          "name": "Approve doctor (admin)",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"verificationStatus\": \"APPROVED\",\n  \"rejectionReason\": \"\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/doctor/approve-doctor" }
        },
        {
          "name": "List doctors (admin)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/doctor/all-doctors?page=1&limit=10" }
        },
        {
          "name": "Update my doctor profile",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"address\": \"123 Updated Test Street\",\n  \"bio\": \"Updated by Postman\",\n  \"consultationFee\": 500,\n  \"contactNumber\": \"01000000000\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/doctor/update-my-profile" }
        },
        {
          "name": "Public doctors available today",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/doctor/public/available-today?page=1&limit=10" }
        },
        {
          "name": "Public doctor list",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/doctor/public/all-doctors?page=1&limit=10" }
        },
        {
          "name": "Public doctor profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/doctor/public/{{doctorId}}" }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Create schedule (saves scheduleId)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const start = new Date(Date.now() + 2 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set('scheduleStartDateTime', start.toISOString());",
              "pm.collectionVariables.set('scheduleEndDateTime', end.toISOString());"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('scheduleId', body.data.id);"
            ] } }
          ],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"startDateTime\": \"{{scheduleStartDateTime}}\",\n  \"endDateTime\": \"{{scheduleEndDateTime}}\",\n  \"meetingLink\": \"https://example.com/meeting\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/schedule/create-schedule" }
        },
        {
          "name": "Get my schedules",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/my-schedules?page=1&limit=10" }
        },
        {
          "name": "List all schedules (admin)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/all-schedules?page=1&limit=10" }
        },
        {
          "name": "Today's schedules (public)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/schedule/todays-schedule?page=1&limit=10" }
        },
        {
          "name": "Update schedule meeting link",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"meetingLink\": \"https://example.com/updated-meeting\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/schedule/update-schedule/{{scheduleId}}" }
        },
        {
          "name": "Publish schedule",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/publish-schedule/{{scheduleId}}" }
        },
        {
          "name": "Get schedule by ID",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/{{scheduleId}}" }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book appointment",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": \"{{scheduleId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/appointment/book-appointment" }
        },
        {
          "name": "Get my appointments (captures pending appointmentId)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const appointments = Array.isArray(body.data) ? body.data : [];",
            "const scheduleId = pm.collectionVariables.get('scheduleId');",
            "const pending = appointments.find(item => item.status === 'PENDING' && (!item.scheduleId || item.scheduleId === scheduleId));",
            "if (pending) {",
            "  pm.collectionVariables.set('appointmentId', pending.id);",
            "  pm.test('Pending appointment ID captured', function () { pm.expect(pending.id).to.be.a('string').and.not.empty; });",
            "}"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/my-appointments?page=1&limit=10&sortBy=createdAt&sortOrder=desc" }
        },
        {
          "name": "Pay appointment (starts bKash flow)",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/appointment/pay-appointment" }
        },
        {
          "name": "Cancel appointment (may initiate refund)",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/appointment/cancel-appointment" }
        },
        {
          "name": "Payment callback (use real bKash callback values)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/appointment/book-appointment/payment/callback?paymentID={{callbackPaymentId}}&status={{callbackStatus}}" }
        },
        {
          "name": "Update appointment status (doctor)",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ONGOING\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/appointment/update-status/{{appointmentId}}" }
        },
        {
          "name": "Get doctor appointments",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/doctor-appointments?page=1&limit=10" }
        },
        {
          "name": "List all appointments (admin)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/all-appointments?page=1&limit=10" }
        },
        {
          "name": "Get appointment by ID",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/{{appointmentId}}" }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get my payments",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const payments = Array.isArray(body.data) ? body.data : [];",
            "const appointmentId = pm.collectionVariables.get('appointmentId');",
            "const payment = payments.find(item => item.appointmentId === appointmentId) || payments[0];",
            "if (payment && payment.id) pm.collectionVariables.set('paymentId', payment.id);"
          ] } }],
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/payment/my-payments?page=1&limit=10" }
        },
        {
          "name": "List all payments (admin)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/payment/all-payments?page=1&limit=10" }
        },
        {
          "name": "Get payment by ID",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/payment/{{paymentId}}" }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        { "name": "Patient analytics", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/analytics/patient-analytics" } },
        { "name": "Doctor analytics", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/analytics/doctor-analytics" } },
        { "name": "Admin analytics", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/analytics/admin-analytics" } }
      ]
    },
    {
      "name": "Cleanup (optional; destructive)",
      "item": [
        { "name": "Delete schedule", "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/{{scheduleId}}" } }
      ]
    }
  ]
}
